<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <preConditions onFail="WARN">
        <not>
            <tableExists tableName="products"/>
        </not>
    </preConditions>

    <changeSet author="vassuv" id="1-initial-schema">
        <createTable tableName="products" remarks="Таблица товаров на складе">
            <column name="id" type="uuid" remarks="Id товара">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)" remarks="Наименование товара">
                <constraints nullable="false"/>
            </column>
            <column name="article" type="varchar(255)" remarks="Артикул товара">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="description" type="varchar(1024)" remarks="Описание товара"/>
            <column name="category" type="varchar(50)" remarks="Категория товара"/>
            <column name="price" type="numeric(19,2)" remarks="Цена товара">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="numeric(19,2)" remarks="Количество товара на складе">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_updated_at" type="timestamptz" remarks="Дата и время последнего обновления товара">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="date" remarks="Дата создания товара">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="products"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
