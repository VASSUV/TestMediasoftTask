<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="add-profile-id-to-customer" author="vasiliy">

        <!-- Шаг 0: очищаем таблицу -->
        <delete tableName="customer" />

        <!-- Шаг 1: добавляем обязательное поле -->
        <addColumn tableName="customer">
            <column name="profile_id" type="UUID" defaultValueComputed="gen_random_uuid()" />
        </addColumn>

        <!-- Шаг 2: сразу NOT NULL (таблица уже пуста) -->
        <addNotNullConstraint tableName="customer" columnName="profile_id" columnDataType="UUID"/>

    </changeSet>

</databaseChangeLog>